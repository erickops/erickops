# ── erickops.space — Environment Variables ──────────────────
# Copy this file to .env.local for local development.
# All variables must be set in Vercel Dashboard → Settings → Environment Variables.

# Owner password — used to protect cat attendance & write page
OWNER_PASSWORD=your_password_here

# GitHub Personal Access Token (scope: repo)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repository in format: username/repo-name
GITHUB_REPO=erickops/erickops

# Upstash Redis — auto-injected by Vercel when you connect Upstash integration
KV_REST_API_URL=https://your-redis-url.upstash.io
KV_REST_API_TOKEN=your_upstash_token_here
KV_REST_API_READ_ONLY_TOKEN=your_upstash_readonly_token_here
KV_URL=redis://your-redis-url
REDIS_URL=rediss://your-redis-url
